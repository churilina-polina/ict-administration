{
  "title": "PostgreSQL - репликация",
  "uid": "pg-replication",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Узел primary (контейнер primary)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(pg_replication_is_replica{job=\"postgres-primary\"}) or vector(-1)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "НЕДОСТУПЕН", "color": "red" }, "0": { "text": "PRIMARY", "color": "green" }, "1": { "text": "REPLICA", "color": "blue" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Узел standby (контейнер standby)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(pg_replication_is_replica{job=\"postgres-standby\"}) or vector(-1)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "НЕДОСТУПЕН", "color": "red" }, "0": { "text": "PRIMARY", "color": "green" }, "1": { "text": "REPLICA", "color": "blue" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Реплик подключено к primary",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(pg_replication_standbys_connected) or vector(0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Отставание реплики сейчас, с",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "max(pg_replication_standby_replay_lag_seconds) or vector(0)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Лаг репликации, байт WAL (primary → реплика)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "pg_replication_standby_lag_bytes", "legendFormat": "{{application_name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Лаг репликации, секунды (replay_lag)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "pg_replication_standby_replay_lag_seconds", "legendFormat": "{{application_name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Транзакции в секунду (commit) по узлам",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "expr": "sum by (job) (rate(pg_stat_database_xact_commit{datname=\"notes\"}[30s]))", "legendFormat": "{{job}}", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "Подключения к БД notes (лимит max_connections = 100)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname=\"notes\"}", "legendFormat": "{{job}}", "refId": "A" },
        { "expr": "max(pg_settings_max_connections)", "legendFormat": "max_connections", "refId": "B" }
      ]
    }
  ]
}
